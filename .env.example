# --- LLM ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini 3.8 Flash does not use sampling parameters such as
# temperature/top_p/top_k. The value is retained here for compatibility
# with the GLM provider.
LLM_TEMPERATURE=0.7

LLM_MAX_TOKENS=700
LLM_TIMEOUT=60
DIGEST_LANGUAGE=en

# --- Pipeline ---
DAILY_TOP_N=8
TZ=Asia/Tehran