# --- LLM (stage 4): any OpenAI-compatible /chat/completions endpoint ---
LLM_PROVIDER=glm
LLM_API_KEY=
LLM_MODEL=glm-5.3
# NOTE: on api.b.ai the glm-5.3 model is premium and needs account balance.
# Free-tier models verified working with a zero balance:
#   qwen3.8-flash, mimo-v2.5, hy3   (set LLM_MODEL=qwen3.8-flash to use one)
LLM_BASE_URL=https://api.b.ai/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=700
LLM_TIMEOUT=60
DIGEST_LANGUAGE=en

# --- Pipeline ---
DAILY_TOP_N=8
TZ=Asia/Tehran
